<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <php>
        <env name="APP_ENV" value="test"/>
        <env name="APP_DEBUG" value="1"/>
        <env name="KERNEL_CLASS" value="Karkas\Adapters\Entry\Http\Kernel"/>
        <env name="DATABASE_URL" value="mysql://karkas:karkas_secret@127.0.0.1:3306/karkas_test?serverVersion=8.0&amp;charset=utf8mb4"/>
        <env name="KARKAS_ADMIN_PASSWORD" value="test-admin-password-stage2"/>
        <env name="DEFAULT_URI" value="http://localhost"/>
    </php>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="http">
            <directory>tests/Http</directory>
        </testsuite>
        <testsuite name="hosting-check">
            <directory>tests/HostingCheck</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
