{
    "name": "dsefremov/karkas-cms",
    "description": "Karkas CMS — modular blog CMS for Timeweb shared hosting (Stage 0 infrastructure)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "symfony/dotenv": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/phpunit-bridge": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Karkas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karkas\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint:php": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
        "fix:php": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "phpstan": "phpstan analyse -c phpstan.neon.dist",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:http": "phpunit --testsuite http",
        "test:hosting-check": "phpunit --testsuite hosting-check",
        "test": "@test:unit && @test:integration && @test:http && @test:hosting-check"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "replace": {},
    "conflict": {
        "symfony/symfony": "*"
    }
}
