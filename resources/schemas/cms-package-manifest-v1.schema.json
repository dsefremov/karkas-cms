{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karkas-cms.local/schemas/cms-package-manifest-v1.schema.json",
  "title": "Karkas unsigned package manifest (cms-core/v1 | cms-module/v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "component",
    "version",
    "requires",
    "files"
  ],
  "properties": {
    "format": {
      "type": "string",
      "enum": ["cms-core/v1", "cms-module/v1"]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["core", "module"]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*\\/[a-z][a-z0-9]*(\\.[a-z0-9]+)*$"
        },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "license": { "type": "string" },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "sdk", "php"],
      "properties": {
        "core": { "type": "string", "minLength": 1 },
        "sdk": { "type": "string", "minLength": 1 },
        "php": { "type": "string", "minLength": 1 },
        "mysql": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "engine": { "type": "string", "enum": ["innodb"] },
            "server": { "type": "string", "minLength": 1 }
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "conflicts": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settings": { "type": "string", "pattern": "^[0-9]+$" },
        "content": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "checksum"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
          },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
