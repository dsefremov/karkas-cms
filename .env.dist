# Copy to .env for local development (never commit real secrets).
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_to_a_random_32_char_string

DATABASE_URL="mysql://karkas:karkas_secret@mysql:3306/karkas?serverVersion=8.0&charset=utf8mb4"

# Stage 2 admin API (set a strong secret in production; enable ZIP via var/flags/zip-upload.enabled).
KARKAS_ADMIN_PASSWORD=change_me_admin_password

DEFAULT_URI=http://localhost:8080

# Dev/test only: expose POST /api/v1/admin/demo/{seed,reset} (never set in production).
# KARKAS_ALLOW_DEMO_SEED=1
