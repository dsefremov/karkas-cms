<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <title>{{ page.title }} — {{ site_label }}</title>
    <link rel="canonical" href="{{ canonical_url|default('/' ~ page.full_path) }}">
</head>
<body>
    <header>
        <p class="muted">{{ site_label }}</p>
        <h1>{{ page.title }}</h1>
    </header>
    <article>
        {{ page.body_text|nl2br }}
    </article>
</body>
</html>
