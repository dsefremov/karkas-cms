<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>{{ site_label }} — Блог</title>
    <link rel="canonical" href="{{ canonical_url|default('/blog') }}">
</head>
<body>
    <main>
        <h1>{{ site_label }} — Блог</h1>
        {% if articles is empty %}
            <p>Пока нет опубликованных статей.</p>
        {% else %}
            <ul>
                {% for article in articles %}
                    <li><a href="/blog/{{ article.slug }}"><strong>{{ article.title }}</strong></a></li>
                {% endfor %}
            </ul>
        {% endif %}
    </main>
</body>
</html>
